{
  "name": "@homelab-telegram-miniapps/design-system",
  "version": "0.1.0",
  "type": "module",
  "description": "Telegram-native design system with theming primitives for Mini Apps",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "telegram",
    "mini-apps",
    "design-system",
    "theming",
    "web-components"
  ],
  "author": "Gregory",
  "license": "UNLICENSED",
  "devDependencies": {
    "@testing-library/dom": "^10.1.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/ui": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {},
  "peerDependencies": {}
}